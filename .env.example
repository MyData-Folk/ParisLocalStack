NODE_ENV=development

DATABASE_URL=postgresql://paris_local:paris_local@localhost:5432/paris_local?schema=public
JWT_SECRET=GENERATE_WITH: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SEED_ADMIN_PASSWORD=

API_PORT=4000
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

LOG_LEVEL=info

UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Backups PostgreSQL -> Cloudflare R2
# BACKUP_S3_BUCKET overrides S3_BUCKET for backups (optional, defaults to S3_BUCKET)
BACKUP_S3_BUCKET=paris-local-backups
BACKUP_RETENTION_DAYS=7
BACKUP_PREFIX=backups/postgres

# Backup monitoring / Healthchecks.io
# Optional. Do not commit real ping URLs.
BACKUP_HEALTHCHECK_URL=

# Future integrations (optional, not required for MVP)
# Google Maps will later suggest/import restaurants, museums, pharmacies and local places.
GOOGLE_MAPS_API_KEY=
# RATP will later power nearby transport lines and public transit itineraries.
RATP_API_KEY=
RATP_API_BASE_URL=

POSTGRES_USER=paris_local
POSTGRES_PASSWORD=paris_local
POSTGRES_DB=paris_local

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-password-change-me
