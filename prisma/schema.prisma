generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  hotel_admin
  receptionist
  guest
}

enum HotelStatus {
  active
  inactive
  draft
}

enum UserStatus {
  active
  inactive
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  role         UserRole
  status       UserStatus  @default(active)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  hotels       HotelUser[]
  messages     Message[]   @relation("UserMessages")

  @@map("users")
}

model Hotel {
  id               String             @id @default(uuid())
  name             String
  slug             String             @unique
  description      String             @default("")
  address          String             @default("")
  city             String             @default("Paris")
  country          String             @default("France")
  phone            String             @default("")
  email            String
  website          String?
  logoUrl          String?            @map("logo_url")
  primaryColor     String             @default("#c9a84c") @map("primary_color")
  secondaryColor   String             @default("#0f172a") @map("secondary_color")
  status           HotelStatus        @default(draft)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  users            HotelUser[]
  guests           Guest[]
  stays            Stay[]
  messages         Message[]
  serviceRequests  ServiceRequest[]
  reviews          Review[]
  recommendations  Recommendation[]
  settings         HotelSettings?
  analyticsEvents  AnalyticsEvent[]
  deployments      Deployment[]
  files            File[]

  @@map("hotels")
}

model HotelUser {
  id        String   @id @default(uuid())
  hotelId   String   @map("hotel_id")
  userId    String   @map("user_id")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotelId, userId])
  @@index([hotelId])
  @@index([userId])
  @@map("hotel_users")
}

model Guest {
  id                 String           @id @default(uuid())
  hotelId            String           @map("hotel_id")
  firstName          String           @map("first_name")
  lastName           String           @map("last_name")
  email              String
  phone              String?
  language           String           @default("fr")
  marketingConsent   Boolean          @default(false) @map("marketing_consent")
  internalNotes      String           @default("") @map("internal_notes")
  crmTags            Json             @default("[]") @map("crm_tags")
  preferences        Json             @default("{}")
  relationshipStatus String           @default("normal") @map("relationship_status")
  createdAt          DateTime         @default(now()) @map("created_at")
  hotel              Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stays              Stay[]
  messages           Message[]
  serviceRequests    ServiceRequest[]
  reviews            Review[]
  analyticsEvents    AnalyticsEvent[]

  @@index([hotelId])
  @@index([hotelId, email])
  @@map("guests")
}

model Stay {
  id           String           @id @default(uuid())
  hotelId      String           @map("hotel_id")
  guestId      String           @map("guest_id")
  roomNumber   String           @map("room_number")
  checkinDate  DateTime?        @map("checkin_date")
  checkoutDate DateTime?        @map("checkout_date")
  status       String           @default("active")
  createdAt    DateTime         @default(now()) @map("created_at")
  hotel        Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest        Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  messages     Message[]
  requests     ServiceRequest[]
  reviews      Review[]

  @@index([hotelId])
  @@index([guestId])
  @@map("stays")
}

model Message {
  id         String    @id @default(uuid())
  hotelId    String    @map("hotel_id")
  guestId    String?   @map("guest_id")
  stayId     String?   @map("stay_id")
  senderType String    @map("sender_type")
  senderId   String?   @map("sender_id")
  content    String
  status     String    @default("sent")
  priority   String    @default("medium")
  createdAt  DateTime  @default(now()) @map("created_at")
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest      Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  stay       Stay?     @relation(fields: [stayId], references: [id], onDelete: SetNull)
  sender     User?     @relation("UserMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@index([guestId])
  @@map("messages")
}

model ServiceRequest {
  id          String   @id @default(uuid())
  hotelId     String   @map("hotel_id")
  guestId     String?  @map("guest_id")
  stayId      String?  @map("stay_id")
  type        String
  title       String
  description String
  details     Json?
  status      String   @default("new")
  priority    String   @default("medium")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest       Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  stay        Stay?    @relation(fields: [stayId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@map("service_requests")
}

model Review {
  id        String   @id @default(uuid())
  hotelId   String   @map("hotel_id")
  guestId   String?  @map("guest_id")
  stayId    String?  @map("stay_id")
  rating    Int
  comment   String?
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest     Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  stay      Stay?    @relation(fields: [stayId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@map("reviews")
}

model Recommendation {
  id          String   @id @default(uuid())
  hotelId     String   @map("hotel_id")
  category    String
  name        String
  description String
  address     String
  phone       String?
  website     String?
  distance    String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  imageUrl    String?  @map("image_url")
  tags        Json     @default("[]")
  openingHours String? @map("opening_hours")
  googlePlaceId String? @map("google_place_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  source      String   @default("manual")
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("recommendations")
}

model HotelSettings {
  id               String   @id @default(uuid())
  hotelId          String   @unique @map("hotel_id")
  wifiName         String?  @map("wifi_name")
  wifiPassword     String?  @map("wifi_password")
  breakfastHours   String?  @map("breakfast_hours")
  checkinTime      String?  @map("checkin_time")
  checkoutTime     String?  @map("checkout_time")
  roomServiceHours String?  @map("room_service_hours")
  receptionPhone   String?  @map("reception_phone")
  whatsappNumber   String?  @map("whatsapp_number")
  guestTheme       String   @default("parisian_boutique") @map("guest_theme")
  languages        Json     @default("[\"fr\",\"en\"]")
  modules          Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("hotel_settings")
}

model AnalyticsEvent {
  id           String   @id @default(uuid())
  hotelId      String   @map("hotel_id")
  guestId      String?  @map("guest_id")
  eventType    String   @map("event_type")
  eventPayload Json     @default("{}") @map("event_payload")
  createdAt    DateTime @default(now()) @map("created_at")
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest        Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@map("analytics_events")
}

model Deployment {
  id          String   @id @default(uuid())
  hotelId     String   @map("hotel_id")
  provider    String
  status      String
  url         String?
  environment Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("deployments")
}

model File {
  id              String   @id @default(uuid())
  hotelId          String   @map("hotel_id")
  filename         String
  originalName     String   @map("original_name")
  mimeType         String   @map("mime_type")
  size             Int
  url              String
  storageProvider  String   @map("storage_provider")
  createdAt        DateTime @default(now()) @map("created_at")
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("files")
}
