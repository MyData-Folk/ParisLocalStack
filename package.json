{
  "name": "paris-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @paris-local/web",
    "dev:web": "npm run dev --workspace @paris-local/web",
    "dev:api": "npm run dev --workspace @paris-local/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @paris-local/web",
    "build:api": "npm run build --workspace @paris-local/api",
    "start:api": "npm run start --workspace @paris-local/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "clsx": "2.1.1",
    "date-fns": "^4.3.0",
    "lucide-react": "^1.16.0",
    "prisma": "^6.8.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.17",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "zustand": "^5.0.13"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
